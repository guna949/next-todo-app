{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "todo-app",
	"main": ".open-next/worker.js",
	// Bump this whenever you want to pick up newer Workers runtime behavior.
	"compatibility_date": "2026-07-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Hyperdrive pools/accelerates the connection from Workers to your
	// Postgres instance (Workers can't open raw TCP sockets directly).
	// Create it with:
	//   npx wrangler hyperdrive create todo-app-db --connection-string="postgres://user:pass@host:5432/db"
	// then paste the returned id below.
"hyperdrive": [
  {
    "binding": "HYPERDRIVE",
    "id": "95706f582207410f8ac4d42e48a59e5f",
    "localConnectionString": "postgresql://postgres:Ahp3uXZBXQEd9UnX@db.qfydnwsvrcyhmppuloto.supabase.co:5432/postgres"
  }
]
}